MEDIA_AGENT_MODE=live
MOCK_IMAGE_PROVIDER_ENABLED=false
ORCHESTRATION_MODE=runtime_first

DEFAULT_IMAGE_PROVIDER=openai_gpt_image
DEFAULT_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_MODEL=gpt-image-2
# AISelf's OpenAI-compatible image route can take several minutes. Keep the
# local/VPS production budgets aligned so a valid upstream request is not
# cut off by the shorter library defaults.
OPENAI_IMAGE_REQUEST_TIMEOUT_SECONDS=600
OPENAI_IMAGE_EDIT_REQUEST_TIMEOUT_SECONDS=900
# Default: openai_standard.  Use generation_only_square_b64 only for an
# explicitly certified gateway that accepts 1024x1024 text-to-image requests
# with response_format=b64_json and does not support image references. Use
# square_b64_reference_edit when that same restricted transport accepts
# reference/edit requests but not quality, output_format, or input_fidelity.
OPENAI_IMAGE_TRANSPORT_PROFILE=openai_standard
# Keep the normal image-edit route explicit. Set a different value only when
# the image-edit endpoint has different, certified request capabilities.
OPENAI_IMAGE_EDIT_TRANSPORT_PROFILE=openai_standard
# Certified image count for the configured edit envelope. Leave empty for the
# profile default; a constrained profile defaults to one. Invalid values fail
# closed before any upstream request.
OPENAI_IMAGE_EDIT_MAX_REFERENCE_IMAGES=
# Set only when a certified gateway needs a smaller transport prompt. The user
# request is retained; only repeated framework guidance may be compacted.
OPENAI_IMAGE_TRANSPORT_MAX_PROMPT_CHARS=0
OPENAI_IMAGE_LOCAL_MAX_REQUESTS_PER_MINUTE=12
OPENAI_IMAGE_LOCAL_MAX_OUTPUTS_PER_MINUTE=24
OPENAI_IMAGE_LOCAL_QUEUE_TIMEOUT_SECONDS=900
OPENAI_IMAGE_UPSTREAM_COOLDOWN_SECONDS=90
OPENAI_IMAGE_MAX_RETRY_AFTER_SECONDS=900
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
GEMINI_IMAGE_BASE_URL=

# Current AISelf gateway default: the configured DeepSeek route is not
# available to every account group; use the verified OpenAI-compatible Brain.
DEFAULT_LLM_PROVIDER=openai
V3_LLM_BRAIN_ENABLED=true
V3_LLM_BRAIN_REMOTE_ENABLED=true
V3_LLM_BRAIN_PROVIDER=openai
V3_LLM_BRAIN_MODEL=gpt-5.6-terra
# V3 Brain uses the complete Chat Completions contract by default in the
# production gateway configuration, matching the verified Codex-compatible
# call. Set chat_stream only for controlled SSE compatibility testing.
V3_LLM_BRAIN_TRANSPORT=chat_nonstream
DEFAULT_LLM_MODEL=gpt-5.6-terra
BACKUP_LLM_PROVIDER=openai
BACKUP_LLM_MODEL=gpt-5.6-terra
OPENAI_LLM_MODEL=gpt-5.6-terra
KIMI_LLM_MODEL=kimi-for-coding
DEEPSEEK_LLM_MODEL=deepseek-v4-pro
DEEPSEEK_LLM_BASE_URL=https://aiself.vip
# Keep the Brain transport and preparation budget explicit so local and VPS
# runtimes do not silently diverge through defaults. The 550-second budget
# covers a 300-second Brain call, the 220-second finalizer reserve, and the
# bounded transport grace window.
V3_LLM_BRAIN_TIMEOUT_SECONDS=300
V3_LLM_BRAIN_EXECUTION_BUDGET_SECONDS=550
V3_LLM_BRAIN_MAX_TOKENS=20000
# Small VPS safety defaults: full V3 generation and multimodal review are
# serialized; raise only after measuring RSS/Swap on a larger deployment.
V3_BACKGROUND_GENERATION_WORKERS=1
V3_VISION_INSPECTION_CONCURRENCY=1
LAB_LLM_PROVIDER=openai
LAB_LLM_MODEL=gpt-5.6-terra
LAB_VISION_PROVIDER=openai
# Set to doubao when a dedicated multimodal review key is configured. This
# explicit V3 route may differ from the general Brain/image route.
V3_VISION_INSPECTION_PROVIDER=
# Vision protocol: auto (Responses first, non-timeout compatibility fallback),
# responses (pin Responses), or chat_completions (pin Chat). Timeouts never switch routes.
V3_VISION_INSPECTION_PROTOCOL=chat_completions
# Outer review deadline. Provider SDK calls receive a bounded inner deadline;
# timeout/manual-review remains fail-closed and never becomes a quality failure.
V3_VISION_INSPECTION_TIMEOUT_SECONDS=120
LLM_PROMPT_PLANNING_ENABLED=true
IMAGE_WORK_INTENSITY=atelier


OPENAI_API_KEY=
OPENAI_BASE_URL=https://aiself.vip/v1
# Set true only when this OpenAI-compatible gateway owns upstream line
# failover, retry and backoff. V3 then keeps one request in flight per logical
# output and waits longer than the gateway's end-to-end budget across line
# switches. aiself uses 600 seconds upstream; keep V3 at 660 seconds so the
# gateway can return its terminal result before V3 gives up. Image SDK retries
# are hard-disabled in code: Smart Router is the sole owner of line switching,
# and V3 must not issue an opaque second gateway request after a transport error.
OPENAI_IMAGE_GATEWAY_MANAGED_FAILOVER=false
OPENAI_IMAGE_GATEWAY_MANAGED_FAILOVER_TIMEOUT_SECONDS=660
# Managed image gateways are called directly by default so a desktop HTTP(S)
# proxy cannot impose a shorter hidden deadline than the documented gateway
# budget. Set false only when the deployment intentionally requires that proxy.
OPENAI_IMAGE_GATEWAY_MANAGED_FAILOVER_BYPASS_ENV_PROXY=true
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://aiself.vip
DEEPSEEK_LLM_API_KEY=
LAB_DOUBAO_VISION_API_KEY=
LAB_DOUBAO_VISION_BASE_URL=https://aiself.vip/v1
LAB_DOUBAO_VISION_MODEL=doubao-seed-2-0-lite-260428
# Optional explicit V3 route values. Empty values fall back to the selected
# LAB_VISION_PROVIDER and its credentials/model.
V3_VISION_INSPECTION_BASE_URL=
V3_VISION_INSPECTION_MODEL=
# Optional server-owned E31 policy override. Empty uses the versioned policy
# packaged with this release; an explicit unreadable or malformed path disables
# activation. It reuses the LAB vision route; never point it at uploaded data,
# a browser URL, or an image-generation route.
ALCHEMY_DOC270_ECOMMERCE_VIEW_POLICY_PATH=
ALCHEMY_DOC270_ECOMMERCE_SOURCE_ANALYSIS_TIMEOUT_SECONDS=60
# Optional server-owned General source policy override. Empty uses the packaged
# Doc281 policy; an explicit unreadable or malformed path disables matching.
# The General source-selection Brain reuses the LAB Vision route; it receives
# the command and reverified originals, never browser metadata or history.
ALCHEMY_DOC281_GENERAL_SOURCE_POLICY_PATH=
ALCHEMY_DOC281_GENERAL_SOURCE_SELECTION_TIMEOUT_SECONDS=30
GEMINI_IMAGE_API_KEY=
BYTEPLUS_API_KEY=

MEDIA_STORAGE_ROOT=.media_storage

# Opt-in cold Job decode processes for full project/global output browsing.
# Keep one API owner. 0 = existing synchronous behavior; 1 or 2 = bounded workers.
# Run the synthetic benchmark and actual 2-core/2-GB acceptance before enabling.
V3_BROWSE_COMPUTE_WORKERS=0
